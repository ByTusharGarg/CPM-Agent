CPM_DATABASE_URL=postgresql+psycopg://cpm:cpm_dev@localhost:5432/cpm
CPM_DEV_SHOW_OTP=1
CPM_SECRET_KEY=change-me-to-a-long-random-string
CPM_CORS_ORIGINS=http://localhost:3010
CPM_APP_URL=http://localhost:3010
# CPM_LLM_PROVIDER=ollama | anthropic (default) | stub
# ANTHROPIC_API_KEY=sk-ant-...
# CPM_SMTP_HOST=smtp.example.com
# CPM_SMTP_USER=...
# CPM_SMTP_PASSWORD=...
# CPM_SMTP_FROM="CPM Agent <pm@example.com>"
# CPM_MULTI_INSTANCE=1   # several API instances on one Postgres

# --- Phase 8: WhatsApp Cloud API (Meta) ---
# CPM_WA_TOKEN=EAAG...                 # permanent system-user token
# CPM_WA_PHONE_NUMBER_ID=1234567890    # from WhatsApp > API setup
# CPM_WA_APP_SECRET=...                # App settings > Basic (verifies webhook signatures)
# CPM_WA_VERIFY_TOKEN=pick-any-string  # same value you type in the Meta webhook form
# CPM_WA_ALERT_TEMPLATE=cpm_alert      # approved template, 1 body variable {{1}} = alert title
# CPM_WA_TEMPLATE_LANG=en
# --- Phase 8: email replies (SendGrid Inbound Parse / Mailgun route) ---
# CPM_EMAIL_INBOUND_SECRET=long-random-string   # webhook URL: <api>/api/channels/email/inbound/<secret>
# CPM_PUBLIC_API_URL=https://api.example.com    # base for signed links in emails
# CPM_TRANSCRIBER=none                          # or faster_whisper (pip install faster-whisper)
